# Servidor Express
PORT=3001
NODE_ENV=production

# Motor de Base de Datos (postgres para Supabase en produccion)
DB_DRIVER=postgres
DATABASE_DRIVER=postgres
SQLITE_DB_PATH=./database/sqlite/psi_aprende.db

# PostgreSQL / Supabase (Session Pooler 5432 recomendado en servidor continuo EC2)
DIRECT_URL=postgresql://postgres.<project_ref>:<db_password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project_ref>:<db_password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase Storage y API
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLIC_BUCKET=psi-public
SUPABASE_PRIVATE_BUCKET=psi-private

# Seguridad JWT (generar secreto aleatorio de 64+ caracteres en produccion)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# CORS (IP publica o dominio del frontend en EC2, separados por coma)
CORS_ORIGIN=http://<EC2_PUBLIC_IP>,https://<TU_DOMINIO>

# Inteligencia Artificial GroqCloud (opcional; editable tambien desde panel Admin)
GROQ_API_KEY=

# Web Push VAPID (opcional; si se dejan vacias se autogeneran en BD)
VAPID_SUBJECT=mailto:contacto@psi-aprende.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
