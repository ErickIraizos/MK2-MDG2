{
  "name": "psi-aprende-pwa",
  "version": "1.0.0",
  "description": "Sistema de Información Web (PWA) Asistido por IA - Centro Psicopedagógico PSI Aprende",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "pwa",
    "psicopedagogia",
    "neuropsicologia",
    "sqlite",
    "supabase",
    "groq-ai",
    "bolivia"
  ],
  "author": "Erick Brayan Iraizos Zanizo",
  "license": "ISC",
  "dependencies": {
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}
